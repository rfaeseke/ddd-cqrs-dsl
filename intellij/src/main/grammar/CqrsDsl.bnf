{
  parserClass='org.fuin.dsl.cqrs.intellij.parser.CqrsParser'
  parserUtilClass='org.fuin.dsl.cqrs.intellij.psi.CqrsParserUtil'

  extends='com.intellij.extapi.psi.ASTWrapperPsiElement'

  psiClassPrefix='Cqrs'
  psiImplClassSuffix='Impl'
  psiPackage='org.fuin.dsl.cqrs.intellij.psi'
  psiImplPackage='org.fuin.dsl.cqrs.intellij.psi.impl'

  elementTypeHolderClass='org.fuin.dsl.cqrs.intellij.psi.CqrsTypes'
  elementTypeClass='org.fuin.dsl.cqrs.intellij.psi.CqrsElementType'
  tokenTypeClass='org.fuin.dsl.cqrs.intellij.psi.CqrsTokenType'

  tokens=[
    // Structural keywords
    KW_CONTEXT='context'
    KW_MODULE='module'
    KW_IMPORT='import'
    KW_DEPENDENCY='dependency'
    KW_LOCAL='local'
    KW_HINT='hint'
    KW_TYPE='type'
    KW_ELEMENT='element'
    KW_GENERICS='generics'
    KW_CONSTRAINT='constraint'
    KW_INPUT='input'
    KW_EXCEPTION='exception'
    KW_BUSINESS_RULE='business-rule'
    KW_ANNOTATION='annotation'
    KW_MESSAGE='message'
    KW_VALUE_OBJECT='value-object'
    KW_BASE='base'
    KW_ENTITY_ID='entity-id'
    KW_ENTITY_ID_PATH='entity-id-path'
    KW_IDENTIFIES='identifies'
    KW_AGGREGATE_ID='aggregate-id'
    KW_ENUM='enum'
    KW_INSTANCES='instances'
    KW_DEPRECATED='deprecated'
    KW_EVENT='event'
    KW_COPIES_ATTRIBUTES_OF='copies-attributes-of'
    KW_ENTITY='entity'
    KW_IDENTIFIER='identifier'
    KW_ROOT='root'
    KW_AGGREGATE='aggregate'
    KW_CONSTRUCTOR='constructor'
    KW_FIRES='fires'
    KW_RETURNS='returns'
    KW_METHOD='method'
    KW_REF='ref'
    KW_SLABEL='slabel'
    KW_LABEL='label'
    KW_TOOLTIP='tooltip'
    KW_PROMPT='prompt'
    KW_EXAMPLES='examples'
    KW_INVARIANTS='invariants'
    KW_PRECONDITIONS='preconditions'
    KW_BUSINESS_RULES='business-rules'
    KW_OPERATION_CONTEXT='operation-context'
    KW_SERVICE='service'
    KW_COMMAND='command'
    KW_TARGET='target'
    KW_SLA='sla'
    KW_COMMAND_HANDLER='command-handler'
    KW_HANDLES='handles'
    KW_USES='uses'
    KW_PROJECTION='projection'
    KW_VIEW='view'
    KW_REST_PATH='rest-path'
    KW_PROCESS_MANAGER='process-manager'
    KW_CRON_SCHEDULE='cron-schedule'
    KW_INSTANCE_KEY='instance-key'
    KW_PROCESS_STATES='process-states'
    KW_REACTS_TO='reacts-to'
    KW_IN_STATE='in-state'
    KW_CORRELATE_BY='correlate-by'
    KW_ISSUES_COMMANDS='issues-commands'
    KW_ADDRESSED_BY='addressed-by'
    KW_TRANSITION_TO='transition-to'
    KW_ARM_TIMEOUT='arm-timeout'
    KW_CANCEL_TIMEOUT='cancel-timeout'
    KW_CONSISTENCY='consistency'
    KW_ACCEPTABLE='acceptable'
    KW_DETECTION='detection'
    KW_RESOLUTION='resolution'
    KW_OPTIONAL='optional'

    // Data protection keywords
    KW_DATA_PROTECTION='data-protection'
    KW_PROTECTED_BY='protected-by'
    KW_PROTECTION='protection'
    KW_CATEGORY='category'
    KW_SUBJECT='subject'
    KW_PURPOSE='purpose'
    KW_LAWFUL_BASIS='lawful-basis'
    KW_RETENTION='retention'
    KW_THEN='then'

    // Time unit keywords
    KW_MILLIS='millis'
    KW_SECONDS='seconds'
    KW_MINUTES='minutes'
    KW_HOURS='hours'
    KW_DAYS='days'
    KW_WEEKS='weeks'
    KW_MONTHS='months'
    KW_YEARS='years'

    // Consistency / detection / resolution value keywords
    KW_WEAK='weak'
    KW_STRONG='strong'
    KW_NEVER='never'
    KW_MANUALLY='manually'
    KW_AUTOMATIC='automatic'
    KW_WORKFLOW='workflow'

    // Protection level value keywords
    KW_NONE='none'
    KW_PERSONAL='personal'
    KW_SENSITIVE='sensitive'

    // Lawful basis value keywords
    KW_CONSENT='consent'
    KW_EXPLICIT_CONSENT='explicit_consent'
    KW_CONTRACT='contract'
    KW_LEGAL_OBLIGATION='legal_obligation'
    KW_VITAL_INTERESTS='vital_interests'
    KW_PUBLIC_TASK='public_task'
    KW_LEGITIMATE_INTERESTS='legitimate_interests'

    // Special category value keywords
    KW_HEALTH='health'
    KW_GENETIC='genetic'
    KW_BIOMETRIC='biometric'
    KW_RACIAL='racial'
    KW_POLITICAL='political'
    KW_RELIGIOUS='religious'
    KW_PHILOSOPHICAL='philosophical'
    KW_TRADE_UNION='trade_union'
    KW_SEX_LIFE='sex_life'
    KW_SEXUAL_ORIENTATION='sexual_orientation'

    // Erasure strategy value keywords
    KW_DELETE='delete'
    KW_ANONYMIZE='anonymize'
    KW_PSEUDONYMIZE='pseudonymize'
    KW_ARCHIVE='archive'
    KW_REVIEW='review'

    // Literal keywords
    KW_TRUE='true'
    KW_FALSE='false'
    KW_NULL='null'

    // Business key, soft delete and rule predicate keywords
    KW_IDENTIFIED_BY='identified-by'
    KW_KEY='key'
    KW_ATTRIBUTES='attributes'
    KW_ON_COLLISION='on-collision'
    KW_DISPLAY_AS='display-as'
    KW_NO_KEY='no-key'
    KW_REFUSE='refuse'
    KW_OVERWRITE='overwrite'
    KW_SKIP='skip'
    KW_REQUIRES='requires'
    KW_IS_EMPTY='is-empty'
    KW_OWN_ID='own-id'
    KW_OWN_PATH='own-path'
    KW_OWN='own'

    // Punctuation
    LBRACE='{'
    RBRACE='}'
    LPAREN='('
    RPAREN=')'
    LT='<'
    GT='>'
    AT='@'
    COMMA=','
    DOT='.'
    DOTDOT='..'
    SLASH='/'
    PIPE='|'
    STAR='*'
    COLON=':'
    LBRACKET='['
    RBRACKET=']'
    EQ='=='
    NEQ='!='
    LE='<='
    GE='>='
    AND='&&'
    OR='||'
    NOT='!'

    // Terminals (the actual matching is done by the JFlex lexer)
    ID='regexp:\^?[A-Za-z][A-Za-z_0-9]*'
    STRING='regexp:"([^\\"]|\\.)*"'
    NUMBER='regexp:[0-9][0-9_]*'
    LINE_COMMENT='regexp://[^\r\n]*'
    BLOCK_COMMENT='regexp:/\*([^*]|\*+[^*/])*\*+/'
    DOC_COMMENT='regexp:/\*\*([^*]|\*+[^*/])*\*+/'
  ]
}

// =========================================================================
// Root
// =========================================================================

domainModel ::= context_def*

// A context holds its dependencies first, then its imports, then its generator hints, then its
// modules. Every element lives in a module; the module name is a qualified name, so a nested
// grouping is written as 'module a.b'.
context_def ::= KW_CONTEXT qualified_name LBRACE dependency_decl* import_decl* hint_def* module_def* RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

module_def ::= KW_MODULE qualified_name LBRACE type_meta_info hint_def* dependency_decl* import_decl* element* RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

// A Maven artifact ("groupId:artifactId:version") providing further models. Two bare STRINGs, so
// Grammar-Kit generates no accessor - read them with CqrsValidationUtil.firstTokenAfter.
dependency_decl ::= KW_DEPENDENCY STRING (KW_LOCAL STRING)? {
  pin=1
}

// Makes types of another module visible under their simple name. The imported name addresses a type
// as 'context.module.Type' and may end in a wildcard on any level.
import_decl ::= KW_IMPORT import_fqn {
  pin=1
}

import_fqn ::= ID (DOT ID)* (DOT STAR)?

hint_def ::= KW_HINT qualified_name json {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

// =========================================================================
// Elements
// =========================================================================

element ::= constraint_def
          | annotation_def
          | external_type
          | service_def
          | value_object
          | entity_id
          | entity_id_path
          | aggregate_id
          | enum_object
          | entity_def
          | aggregate_def
          | exception_def
          | business_rule
          | event_def
          | command_def
          | command_handler
          | projection_def
          | view_def
          | process_manager
          | data_protection_def {
  recoverWhile=element_recover
}

// What an entity or an aggregate may nest: everything a module may hold, except a 'business-rule'.
// A rule written inside an entity belongs to its own 'business_rule*' list, which is matched ahead of
// the constructors - listing it here as well would make the two indistinguishable, exactly as it did
// in the Xtext grammar.
entity_element ::= constraint_def
          | annotation_def
          | external_type
          | service_def
          | value_object
          | entity_id
          | entity_id_path
          | aggregate_id
          | enum_object
          | entity_def
          | aggregate_def
          | exception_def
          | event_def
          | command_def
          | command_handler
          | projection_def
          | view_def
          | process_manager
          | data_protection_def {
  recoverWhile=element_recover
}

private element_recover ::= !(RBRACE | element_start)
// 'AT' (@) starts an annotation instance prefixing a value-object/event, so it must end recovery.
private element_start ::= AT | KW_CONSTRAINT | KW_ANNOTATION | KW_TYPE | KW_SERVICE | KW_VALUE_OBJECT
          | KW_ENTITY_ID | KW_ENTITY_ID_PATH | KW_AGGREGATE_ID | KW_ENUM | KW_ENTITY | KW_AGGREGATE | KW_EXCEPTION
          | KW_BUSINESS_RULE | KW_EVENT | KW_COMMAND | KW_COMMAND_HANDLER | KW_PROJECTION | KW_VIEW | KW_PROCESS_MANAGER | KW_DATA_PROTECTION
          | KW_MODULE | KW_IMPORT

external_type ::= KW_TYPE KW_ELEMENT? ID (KW_GENERICS NUMBER)? {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

constraint_def ::= KW_CONSTRAINT ID (KW_INPUT type_ref (PIPE type_ref)*)? (KW_EXCEPTION type_ref)? LBRACE attribute* (KW_MESSAGE STRING)? RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

annotation_def ::= KW_ANNOTATION ID LBRACE attribute* RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

exception_def ::= KW_EXCEPTION ID LBRACE attribute* KW_MESSAGE STRING RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

// A typed path from an aggregate root down to the entity it addresses. The first step is an aggregate
// identifier and every later one identifies an entity of that aggregate; a step states a range only when
// it takes other than exactly one, which is what an entity containing another of its own kind needs.
entity_id_path ::= KW_ENTITY_ID_PATH ID LBRACE type_meta_info path_segment (SLASH path_segment)* RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

path_segment ::= type_ref segment_range?

segment_range ::= LBRACKET NUMBER DOTDOT (NUMBER | STAR) RBRACKET { pin=1 }

value_object ::= annotation_instance* KW_VALUE_OBJECT ID (KW_BASE type_ref)? invariants? data_protection_instance? LBRACE type_meta_info hint_def* attribute* identified_by? constructor_def* method_def* RBRACE {
  pin=2
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

entity_id ::= KW_ENTITY_ID ID (KW_IDENTIFIES type_ref)? (KW_BASE type_ref)? invariants? data_protection_instance? LBRACE type_meta_info hint_def* attribute* constructor_def* method_def* RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

aggregate_id ::= KW_AGGREGATE_ID ID (KW_IDENTIFIES type_ref)? (KW_BASE type_ref)? invariants? data_protection_instance? LBRACE type_meta_info hint_def* attribute* constructor_def* method_def* RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

enum_object ::= KW_ENUM ID (KW_BASE type_ref)? invariants? data_protection_instance? LBRACE type_meta_info hint_def* attribute* KW_INSTANCES LBRACE enum_instance+ RBRACE RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

enum_instance ::= KW_DEPRECATED? ID (LPAREN literal (COMMA literal)* RPAREN)? overridden_meta? {
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

event_def ::= annotation_instance* KW_EVENT ID (KW_COPIES_ATTRIBUTES_OF type_ref)? LBRACE attribute* (KW_MESSAGE STRING)? RBRACE {
  pin=2
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

entity_def ::= KW_ENTITY ID (KW_IDENTIFIER type_ref)? (KW_ROOT type_ref)? invariants? data_protection_instance? LBRACE type_meta_info hint_def* attribute* business_rule* key_def* no_key? constructor_def* method_def* entity_element* RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

aggregate_def ::= KW_AGGREGATE ID (KW_IDENTIFIER type_ref)? invariants? data_protection_instance? LBRACE type_meta_info hint_def* attribute* business_rule* key_def* no_key? constructor_def* method_def* entity_element* RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

service_def ::= KW_SERVICE ID LBRACE business_rule* method_def* RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

command_def ::= KW_COMMAND ID (KW_TARGET type_ref)? (KW_SLA duration)? LBRACE type_meta_info hint_def* attribute* (KW_MESSAGE STRING)? RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

command_handler ::= KW_COMMAND_HANDLER ID KW_HANDLES type_ref (COMMA type_ref)* (KW_USES type_ref (COMMA type_ref)*)? {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

projection_def ::= KW_PROJECTION ID (KW_INPUT type_ref (COMMA type_ref)*)? {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

view_def ::= KW_VIEW ID KW_USES type_ref (KW_REST_PATH STRING)? LBRACE
    type_meta_info
    hint_def*
    (KW_CRON_SCHEDULE STRING)?
    business_rule* method_def* RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

process_manager ::= KW_PROCESS_MANAGER ID LBRACE
    (KW_CRON_SCHEDULE STRING)?
    (KW_INSTANCE_KEY type_ref)?
    (KW_PROCESS_STATES LBRACE process_state+ RBRACE)?
    process_reaction*
  RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

process_state ::= ID {
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

process_reaction ::= KW_REACTS_TO type_ref (KW_IN_STATE type_ref)? LBRACE
    (KW_CORRELATE_BY ID)?
    (KW_ISSUES_COMMANDS issued_command (COMMA issued_command)*)?
    (KW_TRANSITION_TO type_ref)?
    (KW_ARM_TIMEOUT duration)?
    KW_CANCEL_TIMEOUT?
  RBRACE {
  pin=1
}

// A command a reaction issues; 'addressed-by' names the event component holding the id of the
// target instance (the addressee), a different question from 'correlate-by'.
issued_command ::= type_ref (KW_ADDRESSED_BY ID)?

// =========================================================================
// Members
// =========================================================================

business_rule ::= KW_BUSINESS_RULE ID KW_EXCEPTION type_ref LBRACE attribute* consistency rule_requires? RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

constructor_def ::= KW_CONSTRUCTOR ID preconditions? business_rules? (KW_FIRES type_ref (COMMA type_ref)*)? LBRACE parameter* operation_context? service_def* event_def* RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

method_def ::= KW_METHOD ID (KW_REF type_ref)? preconditions? business_rules? (KW_FIRES type_ref (COMMA type_ref)*)? (KW_REST_PATH STRING)? LBRACE type_meta_info hint_def* parameter* operation_context? return_type? service_def* event_def* RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

// The SPI an operation needs to verify a business rule or fetch data it cannot know itself. Pinned on
// its keyword so the reference stays inside this node while it is still being typed.
operation_context ::= KW_OPERATION_CONTEXT type_ref { pin=1 }

return_type ::= KW_RETURNS KW_OPTIONAL? type_ref generic_args? { pin=1 }

attribute ::= KW_OPTIONAL? type_ref generic_args? ID invariants? data_protection_instance? overridden_meta? {
  pin=4
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

parameter ::= KW_OPTIONAL? type_ref generic_args? ID preconditions? business_rules? overridden_meta? {
  pin=4
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

type_meta_info ::= (KW_SLABEL STRING)? (KW_LABEL STRING)? (KW_TOOLTIP STRING)? (KW_PROMPT STRING)? (KW_EXAMPLES literal*)?

overridden_meta ::= LBRACE type_meta_info hint_def* RBRACE { pin=1 }

generic_args ::= LT type_ref (COMMA type_ref)* GT { pin=1 }

invariants ::= KW_INVARIANTS constraint_instance (COMMA constraint_instance)* { pin=1 }

preconditions ::= KW_PRECONDITIONS constraint_instance (COMMA constraint_instance)* { pin=1 }

business_rules ::= KW_BUSINESS_RULES business_rule_instance (COMMA business_rule_instance)* { pin=1 }

business_rule_instance ::= type_ref (LPAREN rule_argument (COMMA rule_argument)* RPAREN)?

constraint_instance ::= type_ref (LPAREN literal (COMMA literal)* RPAREN)?

// An actual of a business rule usage. A service call is told apart from a plain value by the
// parenthesis that follows it, so it is tried first.
// 'own-id' is a keyword, not a reference: the identity is never a declared attribute, so there is
// nothing for a reference to point at. Ahead of variable_argument because it must not be read as a name.
rule_argument ::= service_call_argument | service_argument | literal

identity_argument ::= KW_OWN_ID

// What addresses the carrier from its root, for an entity whose id does not address it on its own.
entity_path_argument ::= KW_OWN_PATH

// What the carrier holds now, as against what the operation would give it. A bare name resolves to
// the operation's parameter, which an edit commonly names after the very field it would overwrite.
carrier_attribute_argument ::= KW_OWN ID

service_call_argument ::= ID LPAREN (service_argument (COMMA service_argument)*)? RPAREN

// A service asked about the thing being acted on is handed its identity, for the same reason a rule
// takes 'own-id' directly: it is not a declared attribute, so nothing can point at it.
service_argument ::= identity_argument | entity_path_argument | carrier_attribute_argument | variable_argument

variable_argument ::= ID

// =========================================================================
// Business keys, soft delete and the read model's declared identity
// =========================================================================

// The attribute that identifies a read model row, where the attribute's own type cannot say so.
identified_by ::= KW_IDENTIFIED_BY ID { pin=1 }

// Marks the type as soft deleted and names the event that sets the flag - and, where the state can be
// reversed, the one that clears it again.

// The natural key that identifies something without being a surrogate id.
key_def ::= KW_KEY ID (KW_EXCEPTION type_ref)? LBRACE KW_ATTRIBUTES ID (COMMA ID)* KW_ON_COLLISION collision_strategy consistency (KW_DISPLAY_AS STRING)? RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

collision_strategy ::= KW_REFUSE | KW_OVERWRITE | KW_SKIP

// Says that a type has no business key on purpose; the preceding documentation is the reason.
no_key ::= KW_NO_KEY

// =========================================================================
// Business rule predicate
// =========================================================================

rule_requires ::= KW_REQUIRES rule_expr { pin=1 }

rule_expr ::= rule_or

rule_or ::= rule_and (OR rule_and)*

rule_and ::= rule_unary (AND rule_unary)*

rule_unary ::= NOT rule_unary | LPAREN rule_or RPAREN | rule_atom

rule_atom ::= ID rule_atom_tail?

rule_atom_tail ::= compare_op rule_operand
                 | DOT KW_IS_EMPTY LPAREN RPAREN

compare_op ::= EQ | NEQ | LE | GE | LT | GT

// A written-out value is the boundary the rule states about itself - "referenceCount == 0". 'null' is
// listed on its own rather than through 'literal', which also contains it: absence is its own operand.
rule_operand ::= ID | KW_NULL | KW_TRUE | KW_FALSE | NUMBER | STRING

annotation_instance ::= AT type_ref (LPAREN literal (COMMA literal)* RPAREN)? { pin=1 }

// =========================================================================
// Consistency
// =========================================================================

consistency ::= KW_CONSISTENCY consistency_level weak_consistency? { pin=1 }

consistency_level ::= KW_WEAK | KW_STRONG

// The details block owns its braces and is pinned on the opening one, and each clause inside is
// pinned on its own keyword - so a half-typed block keeps its tokens consumed instead of rolling the
// whole group back, which is what keeps the caret inside the business_rule node for code completion
// (same technique as the data protection clauses below). All three clauses are therefore optional
// here and required by CqrsValidationAnnotator instead.
weak_consistency ::= LBRACE wc_acceptable? wc_detection? wc_resolution? RBRACE { pin=1 }

wc_acceptable ::= KW_ACCEPTABLE duration { pin=1 }

wc_detection ::= KW_DETECTION inconsistency_detection { pin=1 }

wc_resolution ::= KW_RESOLUTION inconsistency_resolution { pin=1 }

inconsistency_detection ::= KW_NEVER | KW_MANUALLY | KW_AUTOMATIC

inconsistency_resolution ::= KW_NEVER | KW_MANUALLY | KW_AUTOMATIC | KW_WORKFLOW

duration ::= NUMBER time_unit { pin=1 }

// =========================================================================
// Data protection
// =========================================================================

data_protection_def ::= KW_DATA_PROTECTION ID LBRACE
    dp_protection dp_category? dp_subject? dp_purpose? dp_lawful_basis? dp_retention?
    RBRACE {
  pin=1
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsNamedElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsNamedElementImpl"
}

// Each clause is pinned on its keyword so the keyword stays consumed even while the value is still
// being typed - this keeps the caret inside the data_protection_def node for code completion.
dp_protection   ::= KW_PROTECTION protection_level { pin=1 }
dp_category     ::= KW_CATEGORY special_category (COMMA special_category)* { pin=1 }
dp_subject      ::= KW_SUBJECT STRING { pin=1 }
dp_purpose      ::= KW_PURPOSE STRING { pin=1 }
dp_lawful_basis ::= KW_LAWFUL_BASIS lawful_basis { pin=1 }
dp_retention    ::= KW_RETENTION duration dp_erasure? { pin=1 }
dp_erasure      ::= KW_THEN erasure_strategy { pin=1 }

// Applies a named data protection policy to a type or attribute.
data_protection_instance ::= KW_PROTECTED_BY type_ref { pin=1 }

protection_level ::= KW_NONE | KW_PERSONAL | KW_SENSITIVE

lawful_basis ::= KW_CONSENT | KW_EXPLICIT_CONSENT | KW_CONTRACT | KW_LEGAL_OBLIGATION
              | KW_VITAL_INTERESTS | KW_PUBLIC_TASK | KW_LEGITIMATE_INTERESTS

special_category ::= KW_HEALTH | KW_GENETIC | KW_BIOMETRIC | KW_RACIAL | KW_POLITICAL
              | KW_RELIGIOUS | KW_PHILOSOPHICAL | KW_TRADE_UNION | KW_SEX_LIFE | KW_SEXUAL_ORIENTATION

erasure_strategy ::= KW_DELETE | KW_ANONYMIZE | KW_PSEUDONYMIZE | KW_ARCHIVE | KW_REVIEW

time_unit ::= KW_MILLIS | KW_SECONDS | KW_MINUTES | KW_HOURS | KW_DAYS | KW_WEEKS | KW_MONTHS | KW_YEARS

// =========================================================================
// References, names and literals
// =========================================================================

// A cross-reference to another named element, by simple name or fully qualified name.
type_ref ::= ID (DOT ID)* {
  implements="org.fuin.dsl.cqrs.intellij.psi.CqrsReferenceElement"
  mixin="org.fuin.dsl.cqrs.intellij.psi.impl.CqrsReferenceElementImpl"
}

// The declared (defining) name of a context or module.
qualified_name ::= ID (DOT ID)*

literal ::= KW_NULL | KW_TRUE | KW_FALSE | NUMBER | STRING

// =========================================================================
// Simplified JSON (generator hint value)
// =========================================================================

json ::= json_object | json_array | json_string | json_number | json_boolean | json_null

json_object ::= LBRACE (json_member (COMMA json_member)*)? RBRACE { pin=1 }

json_member ::= STRING COLON json { pin=1 }

json_array ::= LBRACKET (json (COMMA json)*)? RBRACKET { pin=1 }

json_string ::= STRING

json_number ::= NUMBER

json_boolean ::= KW_TRUE | KW_FALSE

json_null ::= KW_NULL
